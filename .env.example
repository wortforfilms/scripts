APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MAATAA_EVENTS_URL=http://localhost:3000/api/spine/events

RADIO_STREAM_URL=http://localhost:8000/live.mp3
NEXT_PUBLIC_RADIO_STREAM_URL=http://localhost:8000/live.mp3
RADIO_PAGE_URL=http://localhost:3000/radio-live
NEXT_PUBLIC_RADIO_PAGE_URL=http://localhost:3000/radio-live

MAATAA_ADMIN_TOKEN=change-me-private-alpha
MAATAA_TTS_MODE=disabled
MAATAA_TTS_LANG=en
MAATAA_TTS_MAX_CHARS=220

RUNTIME_EVENTS_FILE=.maataa-data/runtime-events.jsonl
RUNTIME_STATE_FILE=.maataa-data/runtime-state.json
DATABASE_URL=file:./dev.db
TURSO_AUTH_TOKEN=

AUTH_SESSION_SECRET=change-me-signed-session-secret
AUTH_SESSION_ISSUER=
AUTH_SESSION_AUDIENCE=
MAATAA_ALLOW_DEV_AUTH_COOKIES=false

AUTH_DATABASE_URL=postgresql://maataa:maataa@postgres:5432/maataa
AUTH_REDIS_URL=redis://redis:6379/0
AUTH_JWT_SECRET=change-me-long-random-jwt-secret
AUTH_JWT_ISSUER=maataa-auth
AUTH_JWT_AUDIENCE=maataa-platform
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://scripts.vaigyaaniq.info
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_RUN_MIGRATIONS=true
AUTH_BCRYPT_ROUNDS=12

RAZORPAY_E2E_MODE=local
RAZORPAY_KEY_ID=rzp_test_configure_me
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=change-me-webhook-secret

UPI_PAYEE_VPA=
UPI_PAYEE_NAME=Maataa Scripts
UPI_MERCHANT_CODE=
