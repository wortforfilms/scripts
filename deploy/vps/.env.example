APP_DOMAIN=maataa.example.com
WWW_DOMAIN=www.maataa.example.com
APP_SITE_ADDRESSES=maataa.example.com, app.maataa.example.com, admin.maataa.example.com, api.maataa.example.com, cdn.maataa.example.com
AUTH_DOMAIN=auth.maataa.example.com
AUTH_SITE_ADDRESSES=auth.maataa.example.com
RADIO_DOMAIN=radio.maataa.example.com
RADIO_SITE_ADDRESSES=radio.maataa.example.com
ACME_EMAIL=ops@example.com

APP_BASE_URL=https://maataa.example.com
NEXT_PUBLIC_APP_URL=https://maataa.example.com
NEXT_PUBLIC_MAATAA_EVENTS_URL=https://maataa.example.com/api/spine/events

RADIO_STREAM_URL=https://radio.maataa.example.com/live.mp3
NEXT_PUBLIC_RADIO_STREAM_URL=https://radio.maataa.example.com/live.mp3
RADIO_PAGE_URL=https://maataa.example.com/radio-live
NEXT_PUBLIC_RADIO_PAGE_URL=https://maataa.example.com/radio-live

MAATAA_ADMIN_TOKEN=change-me-private-alpha
MAATAA_TTS_MODE=disabled
MAATAA_TTS_LANG=en
MAATAA_TTS_MAX_CHARS=220

RUNTIME_EVENTS_FILE=/app/.maataa-data/runtime-events.jsonl
RUNTIME_STATE_FILE=/app/.maataa-data/runtime-state.json
DATABASE_URL=file:/app/.maataa-data/runtime.db
TURSO_AUTH_TOKEN=

AUTH_SESSION_SECRET=change-me-signed-session-secret
AUTH_SESSION_ISSUER=
AUTH_SESSION_AUDIENCE=
MAATAA_ALLOW_DEV_AUTH_COOKIES=false

POSTGRES_DB=maataa
POSTGRES_USER=maataa
POSTGRES_PASSWORD=change-me-postgres-password
AUTH_DATABASE_URL=postgresql://maataa:change-me-postgres-password@postgres:5432/maataa
AUTH_REDIS_URL=redis://redis:6379/0
AUTH_JWT_SECRET=change-me-64-byte-auth-secret
AUTH_JWT_ISSUER=maataa-auth
AUTH_JWT_AUDIENCE=maataa-platform
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_BCRYPT_ROUNDS=12
AUTH_COOKIE_DOMAIN=.maataa.example.com
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=none
AUTH_CORS_ORIGINS=https://maataa.example.com,https://app.maataa.example.com,https://admin.maataa.example.com,https://auth.maataa.example.com
AUTH_RUN_MIGRATIONS=true
AUTH_BOOTSTRAP_ADMIN_EMAIL=

RAZORPAY_E2E_MODE=local
RAZORPAY_KEY_ID=rzp_test_configure_me
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=change-me-webhook-secret

UPI_PAYEE_VPA=
UPI_PAYEE_NAME=Maataa Scripts
UPI_MERCHANT_CODE=
