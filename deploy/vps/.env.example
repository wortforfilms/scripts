APP_DOMAIN=maataa.example.com
RADIO_DOMAIN=radio.maataa.example.com
ACME_EMAIL=ops@example.com

APP_BASE_URL=https://maataa.example.com
NEXT_PUBLIC_APP_URL=https://maataa.example.com
NEXT_PUBLIC_MAATAA_EVENTS_URL=https://maataa.example.com/api/spine/events

RADIO_STREAM_URL=https://radio.maataa.example.com/live.mp3
NEXT_PUBLIC_RADIO_STREAM_URL=https://radio.maataa.example.com/live.mp3
RADIO_PAGE_URL=https://maataa.example.com/radio-live
NEXT_PUBLIC_RADIO_PAGE_URL=https://maataa.example.com/radio-live

MAATAA_ADMIN_TOKEN=change-me-private-alpha
MAATAA_TTS_MODE=disabled
MAATAA_TTS_LANG=en
MAATAA_TTS_MAX_CHARS=220

RUNTIME_EVENTS_FILE=/app/.maataa-data/runtime-events.jsonl
RUNTIME_STATE_FILE=/app/.maataa-data/runtime-state.json
DATABASE_URL=file:/app/.maataa-data/runtime.db
