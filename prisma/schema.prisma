generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PublishStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum VerificationStatus {
  UNVERIFIED
  PARTIAL
  VERIFIED
}

enum ScriptDirection {
  LTR
  RTL
  TTB
  BTT
}

enum UserRole {
  USER
  REVIEWER
  ADMIN
  SUPER_ADMIN
}

enum AccountType {
  INDIVIDUAL
  COMPANY
  ORGANIZATION
  GOVERNMENT
}

enum AccountRole {
  OWNER
  ADMIN
  REVIEWER
  MEMBER
  BILLING
}

enum RevenueSplitParty {
  PLATFORM
  CREATOR
  INVESTOR
  SPONSOR
  AFFILIATE
  TAX
}

enum PartnershipType {
  INVESTOR
  SPONSOR
  CREATOR
  AFFILIATE
  PARTNER
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  FAILED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
}

enum SpineJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model Script {
  id                    String             @id
  slug                  String             @unique
  name                  String
  nativeName            String
  verifiedUnicodeSample String?
  fallbackGlyphAsset    String
  family                String
  parentId              String?
  parent                Script?            @relation("ScriptTree", fields: [parentId], references: [id])
  children              Script[]           @relation("ScriptTree")
  region                String?
  eraStart              Int?
  eraEnd                Int?
  direction             ScriptDirection
  verificationStatus    VerificationStatus @default(UNVERIFIED)
  publishStatus         PublishStatus      @default(DRAFT)
  sources               ScriptSource[]
  products              Product[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
}

model User {
  id              String        @id
  email           String        @unique
  name            String
  passwordHash    String        @map("password_hash")
  passwordSalt    String?       @map("password_salt")
  role            UserRole      @default(USER)
  plan            String        @default("FREE")
  permissionsJson String        @default("[]") @map("permissions_json")
  accounts        UserAccount[]
  sessions        Session[]
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@map("auth_users")
}

model Session {
  id            String         @id
  userId        String         @map("user_id")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  userAgent     String?        @map("user_agent")
  ipAddress     String?        @map("ip_address")
  expiresAt     DateTime       @map("expires_at")
  revokedAt     DateTime?      @map("revoked_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id        String    @id
  sessionId String    @map("session_id")
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("auth_refresh_tokens")
}

model Account {
  id        String        @id
  name      String
  type      AccountType
  plan      String        @default("FREE")
  users     UserAccount[]
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@map("accounts")
}

model UserAccount {
  id          String      @id
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String      @map("account_id")
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountRole AccountRole @map("account_role")
  isDefault   Boolean     @default(true) @map("is_default")
  createdAt   DateTime    @default(now()) @map("created_at")

  @@unique([userId, accountId])
  @@map("user_accounts")
}

model ScriptSource {
  id        String   @id @default(cuid())
  scriptId  String
  script    Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  label     String
  url       String?
  createdAt DateTime @default(now())
}

model Product {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  description   String
  productType   String
  scriptId      String?
  script        Script?       @relation(fields: [scriptId], references: [id])
  publishStatus PublishStatus @default(DRAFT)
  isPaid        Boolean       @default(true)
  priceInPaise  Int
  currency      String        @default("INR")
  skus          SKU[]
  bundles       Bundle[]      @relation("BundleProducts")
  accesses      UserAccess[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model SKU {
  id             String          @id @default(cuid())
  code           String          @unique
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  publishStatus  PublishStatus   @default(DRAFT)
  isActive       Boolean         @default(false)
  approvals      AdminApproval[]
  orderItemsJson String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Bundle {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  publishStatus PublishStatus @default(DRAFT)
  products      Product[]     @relation("BundleProducts")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  status          OrderStatus @default(PENDING_PAYMENT)
  amountInPaise   Int
  currency        String      @default("INR")
  paymentProvider String      @default("razorpay")
  providerOrderId String?     @unique
  paymentReference String?
  razorpayOrderId String?     @unique
  itemsJson       String
  payments        Payment[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("OrderRecord")
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String
  providerPaymentId String?
  providerOrderId   String?
  status            PaymentStatus @default(CREATED)
  signatureVerified Boolean       @default(false)
  rawEventJson       String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model UpiReconciliation {
  id         String   @id @default(cuid())
  orderId    String
  verifiedBy String
  reference  String
  proofUrl   String?
  note       String?
  status     String
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("upi_reconciliations")
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  actorId     String?
  subjectId   String?
  severity    String
  payloadJson String?
  createdAt   DateTime @default(now())

  @@map("audit_log")
}

model UserAccess {
  id        String   @id @default(cuid())
  userId    String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId   String
  grantedAt DateTime @default(now())

  @@unique([userId, productId])
}

model AdminApproval {
  id        String        @id @default(cuid())
  skuId     String
  sku       SKU           @relation(fields: [skuId], references: [id], onDelete: Cascade)
  status    PublishStatus
  actorId   String
  note      String?
  createdAt DateTime      @default(now())
}

model SpineEvent {
  id          String   @id @default(cuid())
  type        String
  actorId     String?
  subjectId   String?
  payloadJson String?
  createdAt   DateTime @default(now())
}

model SpineJob {
  id          String         @id @default(cuid())
  type        String
  status      SpineJobStatus @default(PENDING)
  attempts    Int            @default(0)
  payloadJson String?
  lastError   String?
  runAfter    DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model SpineAuditLog {
  id          String   @id @default(cuid())
  eventType   String
  actorId     String?
  subjectId   String?
  payloadJson String?
  createdAt   DateTime @default(now())
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  eventType   String
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@map("webhook_events")
}

model RevenueSplitRule {
  id                    String            @id @default(cuid())
  scopeType             String
  scopeId               String
  party                 RevenueSplitParty
  accountId             String?
  basisPoints           Int
  requiresAdminApproval Boolean           @default(true)
  createdAt             DateTime          @default(now())
}

model RevenueSplitLedger {
  id             String            @id @default(cuid())
  orderId        String
  paymentId      String
  party          RevenueSplitParty
  accountId      String?
  basisPoints    Int
  amountInPaise  Int
  currency       String            @default("INR")
  transferStatus String            @default("PENDING_ADMIN_APPROVAL")
  createdAt      DateTime          @default(now())
}

model FontQaRun {
  id           String   @id @default(cuid())
  status       String
  checkedCount Int
  failedCount  Int
  errorsJson   String
  createdAt    DateTime @default(now())
}

model PartnershipInquiry {
  id           String          @id @default(cuid())
  type         PartnershipType
  name         String
  email        String
  organization String?
  intent       String
  status       String          @default("NEW")
  createdAt    DateTime        @default(now()) @map("created_at")

  @@map("partnership_inquiries")
}
