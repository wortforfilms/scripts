ENVIRONMENT=production
AUTH_DATABASE_URL=postgresql://maataa:change-me@postgres:5432/maataa
AUTH_REDIS_URL=redis://redis:6379/0
AUTH_JWT_SECRET=change-me-64-byte-random-secret
AUTH_JWT_ISSUER=maataa-auth
AUTH_JWT_AUDIENCE=maataa-platform
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_BCRYPT_ROUNDS=12
AUTH_COOKIE_DOMAIN=.scripts.vaigyaaniq.info
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=none
AUTH_CORS_ORIGINS=https://scripts.vaigyaaniq.info,https://app.scripts.vaigyaaniq.info,https://admin.scripts.vaigyaaniq.info
AUTH_RUN_MIGRATIONS=true
